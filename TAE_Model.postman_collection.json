    {
      "name": "👨‍🎓 Student",
      "description": "Student endpoints for viewing assignments and receiving feedback.",
      "item": [
        {
          "name": "🔐 Student Auth",
          "description": "Student authentication endpoints.",
          "item": [
            {
              "name": "1️⃣ Register (Student)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201 || pm.response.code === 200) {",
                      "    try {",
                      "        const json = pm.response.json();",
                      "        if (json.access_token) {",
                      "            pm.environment.set('student_token', json.access_token);",
                      "            console.log('✅ student_token auto-saved from register');",
                      "            console.log('Student:', json.email || json.user.email, '(Role:', json.role || json.user.role + ')');",
                      "        }",
                      "    } catch(e) {",
                      "        console.log('Token not found in response');",
                      "    }",
                      "} else {",
                      "    console.log('Registration failed:', pm.response.code);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
                ],
                "body": {
                  "mode": "urlencoded",
